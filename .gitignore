# ----------------------------
# OS / Editor
# ----------------------------
.DS_Store
Thumbs.db
Desktop.ini

.vscode/
.idea/
*.swp
*.swo

# ----------------------------
# Node / JS
# ----------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ----------------------------
# Python
# ----------------------------
__pycache__/
*.py[cod]
*.pyd
*.pyo
*.pdb
*.egg-info/
.eggs/
dist/
build/

# Virtual environments (keep these OUT of git)
.venv/
venv/
env/
ENV/
workspace/.venv/

# Python tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Jupyter
.ipynb_checkpoints/

# ----------------------------
# n8n data & runtime
# (n8n stores credentials/workflows here; do NOT commit)
# ----------------------------
.n8n/
n8n_data/
n8n_files/

# If you bind-mount to local folders for volumes:
**/.n8n/
**/.n8n-files/

# ----------------------------
# Docker / Compose runtime
# ----------------------------
*.log
*.tmp

# Local env files / secrets
.env
.env.*
!.env.example

# Docker override files
docker-compose.override.yml

# ----------------------------
# Postgres data (if you ever bind-mount it locally)
# ----------------------------
pg_data/
postgres-data/

# ----------------------------
# Workspace outputs (generated by scripts)
# ----------------------------
workspace/out/
workspace/data/*.generated.*
workspace/**/*.png
workspace/**/*.pdf
workspace/**/*.zip

# Keep placeholder folders (optional):
!workspace/out/.gitkeep
!workspace/data/.gitkeep

# ----------------------------
# n8n task runner config copies (optional)
# If this file contains secrets, ignore it and commit a sample instead.
# ----------------------------
n8n-task-runners.json
!n8n-task-runners.example.json
 